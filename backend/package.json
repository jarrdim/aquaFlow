{
  "name": "aquaflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "db:meter-upgrade": "prisma db execute --file prisma/migrations/20260714090000_complete_meter_management/migration.sql --schema prisma/schema.prisma",
    "db:reading-upgrade": "prisma db execute --file prisma/migrations/20260714130000_meter_reading_management/migration.sql --schema prisma/schema.prisma",
    "db:meter-event-upgrade": "prisma db execute --file prisma/migrations/20260714190000_expand_meter_event_types/migration.sql --schema prisma/schema.prisma",
    "db:billing-upgrade": "prisma db execute --file prisma/migrations/20260714210000_billing_management/migration.sql --schema prisma/schema.prisma",
    "db:payment-upgrade": "prisma db execute --file prisma/migrations/20260715100000_payment_revenue_management/migration.sql --schema prisma/schema.prisma",
    "db:mpesa-upgrade": "prisma db execute --file prisma/migrations/20260715120000_mpesa_stk_push/migration.sql --schema prisma/schema.prisma",
    "db:notification-upgrade": "prisma db execute --file prisma/migrations/20260715150000_notification_management/migration.sql --schema prisma/schema.prisma",
    "db:arrears-upgrade": "prisma db execute --file prisma/migrations/20260717090000_arrears_debt_management/migration.sql --schema prisma/schema.prisma",
    "db:tariff-upgrade": "prisma db execute --file prisma/migrations/20260714170000_tariff_management/migration.sql --schema prisma/schema.prisma",
    "db:admin-upgrade": "prisma db execute --file prisma/migrations/20260722230000_admin_permissions/migration.sql --schema prisma/schema.prisma",
    "db:service-request-upgrade": "prisma db execute --file prisma/migrations/20260722231000_service_request_management/migration.sql --schema prisma/schema.prisma",
    "db:settings-upgrade": "prisma db execute --file prisma/migrations/20260723130000_system_settings/migration.sql --schema prisma/schema.prisma",
    "db:legacy-settings-upgrade": "prisma db execute --file prisma/migrations/20260723143000_legacy_majiware_settings/migration.sql --schema prisma/schema.prisma",
    "db:work-order-upgrade": "prisma db execute --file prisma/migrations/20260727143000_work_order_management/migration.sql --schema prisma/schema.prisma",
    "db:connection-upgrade": "prisma db execute --file prisma/migrations/20260727193000_new_connection_management/migration.sql --schema prisma/schema.prisma",
    "db:customer-workflow-upgrade": "prisma db execute --file prisma/migrations/20260730150000_customer_submission_workflows/migration.sql --schema prisma/schema.prisma",
    "db:reconnection-payment-upgrade": "prisma db execute --file prisma/migrations/20260801120000_reconnection_fee_payments/migration.sql --schema prisma/schema.prisma",
    "db:inspection-upgrade": "prisma db execute --file prisma/migrations/20260813090000_field_inspection_contract/migration.sql --schema prisma/schema.prisma",
    "db:disconnection-upgrade": "prisma db execute --file prisma/migrations/20260814100000_field_disconnection_contract/migration.sql --schema prisma/schema.prisma",
    "db:reconnection-field-upgrade": "prisma db execute --file prisma/migrations/20260814170000_field_reconnection_contract/migration.sql --schema prisma/schema.prisma",
    "db:work-order-completion-upgrade": "prisma db execute --file prisma/migrations/20260815090000_field_work_order_completion_contract/migration.sql --schema prisma/schema.prisma",
    "verify:work-order-completion": "node scripts/verify-work-order-completion-contract.js",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
