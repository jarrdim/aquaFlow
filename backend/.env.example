DATABASE_URL="postgresql://aquaflow_user:aquaflow_pass@localhost:5432/aquaflow?schema=aquaflow"
JWT_SECRET="replace-with-a-long-random-string"
# Used to encrypt SMTP/API provider passwords at rest. Keep stable after use;
# changing it makes previously saved provider credentials unreadable.
NOTIFICATION_ENCRYPTION_KEY="replace-with-a-different-long-random-string"
PORT=4000

# Seed behavior. Geography is disabled by default so production/imported zone,
# service-area and route IDs are not consumed or altered by the user seed.
SEED_DEFAULT_PASSWORD="ChangeMe123!"
SEED_DEMO_GEOGRAPHY=false
# After importing zones, optionally assign seeded meter staff to one by code.
# SEED_FIELD_OFFICER_ZONE_CODE="YOUR-ZONE-CODE"

# Safaricom Daraja M-Pesa Express. Never commit real credentials.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="replace-with-new-daraja-key"
MPESA_CONSUMER_SECRET="replace-with-new-daraja-secret"
MPESA_SHORTCODE=174379
MPESA_PASSKEY="replace-with-sandbox-passkey"
# Must be public HTTPS; localhost cannot receive Daraja callbacks.
MPESA_CALLBACK_TOKEN="replace-with-a-long-random-callback-token"
MPESA_CALLBACK_URL="https://your-public-host/api/payments/mpesa/callback?token=the-same-callback-token"
