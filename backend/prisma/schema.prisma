// AquaFlow — Prisma schema for the first working slice: auth + customer management.
//
// This hand-written schema mirrors aquaflow_postgresql_ddl.sql exactly (table/column
// names, types) for the tables this slice touches. Once you've run the full DDL against
// a real Postgres database, you can run `npm run prisma:pull` to have Prisma introspect
// the *entire* 66-table schema and regenerate this file automatically — this file is a
// deliberately small starting subset so you have something to build and run today.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["aquaflow"]
}

model Zone {
  zoneId      BigInt   @id @default(autoincrement()) @map("zone_id")
  zoneCode    String   @unique @map("zone_code")
  zoneName    String   @map("zone_name")
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  serviceAreas       ServiceArea[]
  routes             Route[]
  properties         Property[]
  meterAssignments   MeterAssignment[]
  boreholes          Borehole[]
  fieldOfficers      FieldOfficer[]
  disconnectionLists DisconnectionList[]

  @@map("zones")
  @@schema("aquaflow")
}

model ServiceArea {
  serviceAreaId BigInt   @id @default(autoincrement()) @map("service_area_id")
  zoneId        BigInt   @map("zone_id")
  areaCode      String   @unique @map("area_code")
  areaName      String   @map("area_name")
  areaType      String   @map("area_type") // ESTATE | VILLAGE | MARKET | INDUSTRIAL | OTHER
  description   String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  zone       Zone       @relation(fields: [zoneId], references: [zoneId])
  properties Property[]

  @@map("service_areas")
  @@schema("aquaflow")
}

model Route {
  routeId            BigInt   @id @default(autoincrement()) @map("route_id")
  zoneId             BigInt   @map("zone_id")
  routeCode          String   @unique @map("route_code")
  routeName          String   @map("route_name")
  sequenceNumber     Int?     @map("sequence_number")
  estimatedCustomers Int?     @map("estimated_customers")
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  zone               Zone              @relation(fields: [zoneId], references: [zoneId])
  properties         Property[]
  accounts           CustomerAccount[]
  readingAssignments RouteAssignment[]

  @@map("routes")
  @@schema("aquaflow")
}

model CustomerCategory {
  categoryId   BigInt   @id @default(autoincrement()) @map("category_id")
  categoryCode String   @unique @map("category_code")
  categoryName String   @unique @map("category_name")
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  accounts          CustomerAccount[]
  tariffs           Tariff[]
  tariffAssignments TariffCategoryAssignment[]

  @@map("customer_categories")
  @@schema("aquaflow")
}

model Customer {
  customerId         BigInt   @id @default(autoincrement()) @map("customer_id")
  customerNumber     String   @unique @map("customer_number")
  customerType       String   @map("customer_type") // INDIVIDUAL | ORGANIZATION
  firstName          String?  @map("first_name")
  middleName         String?  @map("middle_name")
  lastName           String?  @map("last_name")
  organizationName   String?  @map("organization_name")
  nationalId         String?  @unique @map("national_id")
  registrationNumber String?  @unique @map("registration_number")
  phoneNumber        String   @map("phone_number")
  alternativePhone   String?  @map("alternative_phone")
  emailAddress       String?  @map("email_address")
  preferredLanguage  String   @default("EN") @map("preferred_language")
  status             String   @default("ACTIVE")
  registrationDate   DateTime @default(now()) @map("registration_date") @db.Date
  createdBy          BigInt?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  properties      Property[]
  accounts        CustomerAccount[]
  users           User[]
  notifications   Notification[]
  serviceRequests ServiceRequest[]

  @@map("customers")
  @@schema("aquaflow")
}

model Property {
  propertyId      BigInt   @id @default(autoincrement()) @map("property_id")
  propertyCode    String   @unique @map("property_code")
  ownerCustomerId BigInt?  @map("owner_customer_id")
  zoneId          BigInt   @map("zone_id")
  serviceAreaId   BigInt?  @map("service_area_id")
  routeId         BigInt?  @map("route_id")
  plotNumber      String?  @map("plot_number")
  buildingName    String?  @map("building_name")
  physicalAddress String   @map("physical_address")
  gpsLatitude     Decimal? @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude    Decimal? @map("gps_longitude") @db.Decimal(10, 7)
  occupancyStatus String   @default("OWNER_OCCUPIED") @map("occupancy_status")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  owner       Customer?         @relation(fields: [ownerCustomerId], references: [customerId])
  zone        Zone              @relation(fields: [zoneId], references: [zoneId])
  serviceArea ServiceArea?      @relation(fields: [serviceAreaId], references: [serviceAreaId])
  route       Route?            @relation(fields: [routeId], references: [routeId])
  accounts    CustomerAccount[]

  @@map("properties")
  @@schema("aquaflow")
}

model CustomerAccount {
  accountId      BigInt    @id @default(autoincrement()) @map("account_id")
  accountNumber  String    @unique @map("account_number")
  customerId     BigInt    @map("customer_id")
  propertyId     BigInt    @map("property_id")
  categoryId     BigInt    @map("category_id")
  routeId        BigInt?   @map("route_id")
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(18, 2)
  currentBalance Decimal   @default(0) @map("current_balance") @db.Decimal(18, 2)
  connectionDate DateTime? @map("connection_date") @db.Date
  accountStatus  String    @default("PENDING") @map("account_status")
  closureDate    DateTime? @map("closure_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  customer             Customer                @relation(fields: [customerId], references: [customerId])
  property             Property                @relation(fields: [propertyId], references: [propertyId])
  category             CustomerCategory        @relation(fields: [categoryId], references: [categoryId])
  route                Route?                  @relation(fields: [routeId], references: [routeId])
  meterAssignments     MeterAssignment[]
  meterReplacements    MeterReplacement[]
  meterReadings        MeterReading[]
  bills                Bill[]
  payments             Payment[]
  receipts             Receipt[]
  suspensePayments     SuspensePayment[]
  mpesaStkRequests     MpesaStkRequest[]
  generalNotifications Notification[]
  paymentPlans         PaymentPlan[]
  promisesToPay        PromiseToPay[]
  debtNotices          DebtNotice[]
  disconnectionItems   DisconnectionListItem[]
  debtWriteOffs        DebtWriteOff[]
  arrearsActions       ArrearsAction[]
  serviceRequests      ServiceRequest[]

  @@map("customer_accounts")
  @@schema("aquaflow")
}

model User {
  userId           BigInt    @id @default(autoincrement()) @map("user_id")
  username         String    @unique
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  emailAddress     String    @unique @map("email_address")
  phoneNumber      String?   @unique @map("phone_number")
  passwordHash     String    @map("password_hash")
  userType         String    @map("user_type") // STAFF | CUSTOMER | SYSTEM
  customerId       BigInt?   @map("customer_id")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  status           String    @default("PENDING")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  customer                       Customer?                    @relation(fields: [customerId], references: [customerId])
  userRoles                      UserRole[]
  meterEvents                    MeterEvent[]                 @relation("MeterEventUser")
  fieldOfficer                   FieldOfficer?
  createdReadingCycles           ReadingCycle[]               @relation("ReadingCycleCreator")
  assignedReadingRoutes          RouteAssignment[]            @relation("ReadingRouteAssigner")
  approvedReadings               MeterReading[]               @relation("ReadingApprover")
  readingEvents                  MeterReadingEvent[]          @relation("ReadingEventUser")
  createdTariffs                 Tariff[]                     @relation("TariffCreator")
  approvedTariffs                Tariff[]                     @relation("TariffApprover")
  tariffEvents                   TariffEvent[]                @relation("TariffEventUser")
  tariffSimulations              TariffSimulation[]           @relation("TariffSimulationUser")
  tariffAssignments              TariffCategoryAssignment[]   @relation("TariffAssignmentUser")
  createdBillingCycles           BillingCycle[]               @relation("BillingCycleCreator")
  postedBillingCycles            BillingCycle[]               @relation("BillingCyclePoster")
  generatedBills                 Bill[]                       @relation("BillGenerator")
  approvedBills                  Bill[]                       @relation("BillApprover")
  postedBills                    Bill[]                       @relation("BillPoster")
  requestedBillingAdjustments    BillingAdjustment[]          @relation("BillingAdjustmentRequester")
  approvedBillingAdjustments     BillingAdjustment[]          @relation("BillingAdjustmentApprover")
  billingEvents                  BillingEvent[]               @relation("BillingEventUser")
  sentBillNotifications          BillNotification[]           @relation("BillNotificationSender")
  attemptedBillingAlerts         BillingSecurityAlert[]       @relation("BillingAlertAttemptUser")
  resolvedBillingAlerts          BillingSecurityAlert[]       @relation("BillingAlertResolver")
  receivedPayments               Payment[]                    @relation("PaymentReceiver")
  paymentAllocations             PaymentAllocation[]          @relation("PaymentAllocator")
  requestedPaymentReversals      PaymentReversal[]            @relation("PaymentReversalRequester")
  approvedPaymentReversals       PaymentReversal[]            @relation("PaymentReversalApprover")
  issuedReceipts                 Receipt[]                    @relation("ReceiptIssuer")
  resolvedSuspensePayments       SuspensePayment[]            @relation("SuspenseResolver")
  paymentEvents                  PaymentEvent[]               @relation("PaymentEventUser")
  createdReconciliationBatches   PaymentReconciliationBatch[] @relation("ReconciliationCreator")
  completedReconciliationBatches PaymentReconciliationBatch[] @relation("ReconciliationCompleter")
  initiatedMpesaStkRequests      MpesaStkRequest[]            @relation("MpesaStkInitiator")
  createdNotificationTemplates   NotificationTemplate[]       @relation("NotificationTemplateCreator")
  createdNotificationProviders   NotificationProvider[]       @relation("NotificationProviderCreator")
  requestedNotifications         Notification[]               @relation("NotificationRequester")
  createdPaymentPlans            PaymentPlan[]                @relation("PaymentPlanCreator")
  approvedPaymentPlans           PaymentPlan[]                @relation("PaymentPlanApprover")
  recordedPromises               PromiseToPay[]               @relation("PromiseRecorder")
  createdDebtNotices             DebtNotice[]                 @relation("DebtNoticeCreator")
  approvedDebtNotices            DebtNotice[]                 @relation("DebtNoticeApprover")
  createdDisconnectionLists      DisconnectionList[]          @relation("DisconnectionListCreator")
  approvedDisconnectionLists     DisconnectionList[]          @relation("DisconnectionListApprover")
  requestedDebtWriteOffs         DebtWriteOff[]               @relation("DebtWriteOffRequester")
  decidedDebtWriteOffs           DebtWriteOff[]               @relation("DebtWriteOffApprover")
  arrearsActions                 ArrearsAction[]              @relation("ArrearsActionUser")
  createdServiceRequests         ServiceRequest[]             @relation("ServiceRequestCreator")
  assignedServiceRequests        ServiceRequest[]             @relation("ServiceRequestAssignee")
  serviceRequestEvents           ServiceRequestEvent[]        @relation("ServiceRequestEventUser")

  @@map("users")
  @@schema("aquaflow")
}

model Role {
  roleId      BigInt   @id @default(autoincrement()) @map("role_id")
  roleCode    String   @unique @map("role_code")
  roleName    String   @unique @map("role_name")
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("aquaflow")
}

model Permission {
  permissionId   BigInt   @id @default(autoincrement()) @map("permission_id")
  permissionCode String   @unique @map("permission_code")
  moduleName     String   @map("module_name")
  permissionName String   @map("permission_name")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("aquaflow")
}

model UserRole {
  userRoleId    BigInt    @id @default(autoincrement()) @map("user_role_id")
  userId        BigInt    @map("user_id")
  roleId        BigInt    @map("role_id")
  assignedBy    BigInt?   @map("assigned_by")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  status        String    @default("ACTIVE")

  user User @relation(fields: [userId], references: [userId])
  role Role @relation(fields: [roleId], references: [roleId])

  @@map("user_roles")
  @@schema("aquaflow")
}

model RolePermission {
  rolePermissionId BigInt   @id @default(autoincrement()) @map("role_permission_id")
  roleId           BigInt   @map("role_id")
  permissionId     BigInt   @map("permission_id")
  grantedBy        BigInt?  @map("granted_by")
  grantedAt        DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [roleId])
  permission Permission @relation(fields: [permissionId], references: [permissionId])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("aquaflow")
}

model SystemSetting {
  settingId              BigInt   @id @default(autoincrement()) @map("setting_id")
  utilityName            String   @default("AquaFlow") @map("utility_name")
  utilityCode            String   @default("AQUAFLOW") @map("utility_code")
  emailAddress           String?  @map("email_address")
  phoneNumber            String?  @map("phone_number")
  secondaryPhoneNumber   String?  @map("secondary_phone_number")
  postalAddress          String?  @map("postal_address")
  postalCode             String?  @map("postal_code")
  physicalAddress        String?  @map("physical_address")
  currencyCode           String   @default("KES") @map("currency_code")
  timezone               String   @default("Africa/Nairobi")
  locale                 String   @default("en-KE")
  dateFormat             String   @default("DD/MM/YYYY") @map("date_format")
  billingDueDays         Int      @default(14) @map("billing_due_days")
  defaultBillingRate     Decimal? @map("default_billing_rate") @db.Decimal(18, 2)
  subprojectDiscountRate Decimal? @map("subproject_discount_rate") @db.Decimal(5, 2)
  reconnectionFee        Decimal? @map("reconnection_fee") @db.Decimal(18, 2)
  defaultConnectionFee   Decimal? @map("default_connection_fee") @db.Decimal(18, 2)
  readingVariancePercent Decimal  @default(30) @map("reading_variance_percent") @db.Decimal(5, 2)
  minimumReadingValue    Decimal  @default(0) @map("minimum_reading_value") @db.Decimal(18, 3)
  billingMessageLine1    String?  @map("billing_message_line_1")
  billingMessageLine2    String?  @map("billing_message_line_2")
  billingMessageLine3    String?  @map("billing_message_line_3")
  demandMessageLine1     String?  @map("demand_message_line_1")
  demandMessageLine2     String?  @map("demand_message_line_2")
  demandMessageLine3     String?  @map("demand_message_line_3")
  demandMessageLine4     String?  @map("demand_message_line_4")
  demandMessageLine5     String?  @map("demand_message_line_5")
  receiptMessage         String?  @map("receipt_message")
  sessionTimeoutMinutes  Int      @default(30) @map("session_timeout_minutes")
  passwordMinimumLength  Int      @default(8) @map("password_minimum_length")
  requireTwoFactor       Boolean  @default(false) @map("require_two_factor")
  maintenanceMode        Boolean  @default(false) @map("maintenance_mode")
  updatedBy              BigInt?  @map("updated_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
  @@schema("aquaflow")
}

model NewConnectionApplication {
  connectionApplicationId BigInt    @id @default(autoincrement()) @map("connection_application_id")
  applicationNumber       String    @unique @map("application_number")
  customerId              BigInt?   @map("customer_id")
  applicantType           String    @default("INDIVIDUAL") @map("applicant_type")
  applicantName           String    @map("applicant_name")
  identificationNumber    String?   @map("identification_number")
  phoneNumber             String    @map("phone_number")
  emailAddress            String?   @map("email_address")
  physicalAddress         String    @map("physical_address")
  plotNumber              String?   @map("plot_number")
  zoneId                  BigInt?   @map("zone_id")
  connectionType          String    @default("DOMESTIC") @map("connection_type")
  status                  String    @default("SUBMITTED")
  connectionFee           Decimal   @default(0) @map("connection_fee") @db.Decimal(18, 2)
  connectionFeeOverridden Boolean   @default(false) @map("connection_fee_overridden")
  feeOverrideReason       String?   @map("fee_override_reason")
  inspectionScheduledAt   DateTime? @map("inspection_scheduled_at")
  inspectionOfficerId     BigInt?   @map("inspection_officer_id")
  inspectionOutcome       String?   @map("inspection_outcome")
  inspectionNotes         String?   @map("inspection_notes")
  materialsCost           Decimal   @default(0) @map("materials_cost") @db.Decimal(18, 2)
  labourCost              Decimal   @default(0) @map("labour_cost") @db.Decimal(18, 2)
  quotationTotal          Decimal   @default(0) @map("quotation_total") @db.Decimal(18, 2)
  amountPaid              Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 2)
  paymentReference        String?   @map("payment_reference")
  decisionNotes           String?   @map("decision_notes")
  accountId               BigInt?   @map("account_id")
  workOrderId             BigInt?   @map("work_order_id")
  remarks                 String?
  createdBy               BigInt?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  activities NewConnectionActivity[]

  @@map("new_connection_applications")
  @@schema("aquaflow")
}

model NewConnectionActivity {
  connectionActivityId    BigInt   @id @default(autoincrement()) @map("connection_activity_id")
  connectionApplicationId BigInt   @map("connection_application_id")
  activityType            String   @map("activity_type")
  notes                   String?
  performedBy             BigInt?  @map("performed_by")
  performedAt             DateTime @default(now()) @map("performed_at")

  application NewConnectionApplication @relation(fields: [connectionApplicationId], references: [connectionApplicationId])

  @@map("new_connection_activities")
  @@schema("aquaflow")
}

model ServiceRequest {
  serviceRequestId BigInt    @id @default(autoincrement()) @map("service_request_id")
  requestNumber    String    @unique @map("request_number")
  requestType      String    @map("request_type")
  customerId       BigInt?   @map("customer_id")
  accountId        BigInt?   @map("account_id")
  category         String
  subject          String
  description      String
  contactChannel   String    @default("PHONE") @map("contact_channel")
  priority         String    @default("MEDIUM")
  status           String    @default("OPEN")
  assignedTo       BigInt?   @map("assigned_to")
  dueAt            DateTime? @map("due_at")
  resolution       String?
  resolvedAt       DateTime? @map("resolved_at")
  closedAt         DateTime? @map("closed_at")
  locationDetails  String?   @map("location_details")
  photoEvidence    String?   @map("photo_evidence")
  createdBy        BigInt?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  customer Customer?             @relation(fields: [customerId], references: [customerId])
  account  CustomerAccount?      @relation(fields: [accountId], references: [accountId])
  creator  User?                 @relation("ServiceRequestCreator", fields: [createdBy], references: [userId])
  assignee User?                 @relation("ServiceRequestAssignee", fields: [assignedTo], references: [userId])
  events   ServiceRequestEvent[]

  @@index([status, priority])
  @@index([customerId])
  @@index([accountId])
  @@map("service_requests")
  @@schema("aquaflow")
}

model ServiceRequestEvent {
  serviceRequestEventId BigInt   @id @default(autoincrement()) @map("service_request_event_id")
  serviceRequestId      BigInt   @map("service_request_id")
  eventType             String   @map("event_type")
  oldStatus             String?  @map("old_status")
  newStatus             String?  @map("new_status")
  comments              String?
  performedBy           BigInt?  @map("performed_by")
  createdAt             DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [serviceRequestId], onDelete: Cascade)
  performer      User?          @relation("ServiceRequestEventUser", fields: [performedBy], references: [userId])

  @@index([serviceRequestId, createdAt])
  @@map("service_request_events")
  @@schema("aquaflow")
}

model Borehole {
  boreholeId        BigInt    @id @default(autoincrement()) @map("borehole_id")
  boreholeCode      String    @unique @map("borehole_code")
  boreholeName      String    @map("borehole_name")
  zoneId            BigInt    @map("zone_id")
  gpsLatitude       Decimal   @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude      Decimal   @map("gps_longitude") @db.Decimal(10, 7)
  depthMetres       Decimal?  @map("depth_metres") @db.Decimal(10, 2)
  ratedCapacity     Decimal?  @map("rated_capacity_m3_hour") @db.Decimal(18, 3)
  commissioningDate DateTime? @map("commissioning_date") @db.Date
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  zone        Zone              @relation(fields: [zoneId], references: [zoneId])
  assignments MeterAssignment[]

  @@map("boreholes")
  @@schema("aquaflow")
}

model FieldOfficer {
  fieldOfficerId     BigInt   @id @default(autoincrement()) @map("field_officer_id")
  userId             BigInt   @unique @map("user_id")
  employeeNumber     String   @unique @map("employee_number")
  officerType        String   @map("officer_type")
  phoneNumber        String   @map("phone_number")
  homeZoneId         BigInt?  @map("home_zone_id")
  availabilityStatus String   @default("AVAILABLE") @map("availability_status")
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  user             User              @relation(fields: [userId], references: [userId])
  homeZone         Zone?             @relation(fields: [homeZoneId], references: [zoneId])
  routeAssignments RouteAssignment[]
  readings         MeterReading[]

  @@map("field_officers")
  @@schema("aquaflow")
}

model ReadingCycle {
  readingCycleId BigInt   @id @default(autoincrement()) @map("reading_cycle_id")
  cycleCode      String   @unique @map("cycle_code")
  cycleName      String   @map("cycle_name")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  billingCycleId BigInt?  @map("billing_cycle_id")
  status         String   @default("PLANNED")
  createdBy      BigInt?  @map("created_by")
  remarks        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  creator          User?             @relation("ReadingCycleCreator", fields: [createdBy], references: [userId])
  routeAssignments RouteAssignment[]
  readings         MeterReading[]
  billingCycle     BillingCycle?     @relation(fields: [billingCycleId], references: [billingCycleId])

  @@map("reading_cycles")
  @@schema("aquaflow")
}

model RouteAssignment {
  routeAssignmentId BigInt    @id @default(autoincrement()) @map("route_assignment_id")
  readingCycleId    BigInt    @map("reading_cycle_id")
  routeId           BigInt    @map("route_id")
  fieldOfficerId    BigInt    @map("field_officer_id")
  assignedDate      DateTime  @default(now()) @map("assigned_date") @db.Date
  status            String    @default("ASSIGNED")
  assignedBy        BigInt?   @map("assigned_by")
  completedAt       DateTime? @map("completed_at")
  remarks           String?
  createdAt         DateTime  @default(now()) @map("created_at")

  cycle        ReadingCycle @relation(fields: [readingCycleId], references: [readingCycleId])
  route        Route        @relation(fields: [routeId], references: [routeId])
  fieldOfficer FieldOfficer @relation(fields: [fieldOfficerId], references: [fieldOfficerId])
  assigner     User?        @relation("ReadingRouteAssigner", fields: [assignedBy], references: [userId])

